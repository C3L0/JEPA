{
  "model": {
    "state_dim": 14,
    "action_dim": 14,
    "latent_dim": 256,
    "projector_dim": 512,
    "hidden_dim": 512,
    "mlp_depth": 2,
    "max_horizon": 20
  },
  "loss": {
    "prediction": "smooth_l1",
    "prediction_weight": 1.0,
    "vicreg_weight": 1.0,
    "vicreg_sim_coeff": 1.0,
    "vicreg_var_coeff": 10.0,
    "vicreg_cov_coeff": 0.04,
    "vicreg_gamma": 1.0,
    "eps": 0.0001
  },
  "train": {
    "epochs": 10,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "grad_clip_norm": 1.0,
    "ema_start": 0.99,
    "ema_end": 0.999,
    "seed": 42,
    "log_every_steps": 50,
    "checkpoint_every_epochs": 5
  }
}